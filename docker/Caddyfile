# Proxy TLS (§182). Único serviço com porta exposta.
# APP_DOMAIN=intranet.fazendaprogresso.com → certificado automático (ACME/Let's Encrypt).
# APP_DOMAIN=localhost (padrão) → certificado da CA interna do Caddy, para desenvolvimento.
# MinIO (9000) substituído pelo Garage (3900) — API S3 compatível.
{
	email {$ACME_EMAIL:admin@localhost}
}

{$APP_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Download de arquivos (RN-DOC-007): só GET/HEAD com URL pré-assinada curta, gerada pela
	# aplicação depois de checar permissão e audiência. O bucket é privado: sem assinatura, o
	# Garage recusa. Upload e demais métodos nunca passam por aqui (vão da aplicação direto ao Garage).
	@files {
		path /{$S3_BUCKET:fpone-files}/*
		method GET HEAD
	}
	handle @files {
		reverse_proxy garage:3900
	}

	handle {
		reverse_proxy web:3000
	}
}
