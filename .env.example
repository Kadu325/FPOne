# FPOne Intranet: variáveis de ambiente.
# Copie para .env e preencha. O .env NUNCA vai para o Git.
# MinIO foi substituído pelo Garage (S3-compatível). Ver compose.yaml e docker/garage.toml.

# --- Proxy / TLS ---
APP_DOMAIN=localhost
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443

# --- Banco (PostgreSQL 16) ---
POSTGRES_USER=fpone
POSTGRES_PASSWORD=
POSTGRES_DB=fpone
DATABASE_URL=

# --- Armazenamento (Garage, API S3-compatível) ---
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
S3_BUCKET=fpone-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
GARAGE_ENDPOINT=http://garage:3900
S3_PUBLIC_URL=

# --- Autenticação (Auth.js) ---
AUTH_SECRET=
AUTH_URL=
AUTH_SESSION_HOURS=8
CPF_PEPPER=

# ---------- Active Directory / LDAP ----------
AD_ENABLED=true
LDAP_HOST='192.168.77.250'
LDAP_PORT=389
LDAP_SECURITY='none'
LDAP_BASE_DN='dc=fazendaprogresso,dc=com,dc=local'
LDAP_BIND_DN='FP\glpi'
LDAP_BIND_PASSWORD=''
LDAP_LOGIN_ATTRIBUTE='sAMAccountName'
LDAP_USER_FILTER='(&(objectClass=user)(objectCategory=person)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))'
LDAP_TIMEOUT_MS=5000
LDAP_CONNECT_TIMEOUT_MS=5000
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_CA_CERT_PATH=''

# ---------- Proteção contra força bruta ----------
LOGIN_MAX_FAILS_PER_USER=5
LOGIN_MAX_FAILS_PER_IP=20
LOGIN_RATE_WINDOW_MINUTES=15
TRUST_PROXY=false

# ---------- Suporte TI ----------
GLPI_TICKET_URL=''
IT_SUPPORT_PHONE=''
IT_SUPPORT_EMAIL=''

# --- Identidade ---
NEXT_PUBLIC_COMPANY_NAME="Fazenda Progresso"
NEXT_PUBLIC_APP_ENV=production

# --- Feature flags ---
AUDIT_RETENTION_MONTHS=24
DEMO_MODE=false
FEATURE_AI_SEARCH=false

# --- Backup ---
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=14
