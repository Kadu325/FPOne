# FPOne Intranet: Variáveis de Ambiente para Servidor Debian Linux
# Copie este arquivo para .env no servidor: `cp .env.example .env`
# O arquivo .env NUNCA deve ser commitado no Git.

# ==============================================================================
# 1. Configuração dos 4 Subdomínios & Proxy Reverso (Traefik v3)
# ==============================================================================
# Aponte as entradas DNS (tipo A ou CNAME) para o IP do seu servidor Debian.

# Subdomínio 1: Portal da Intranet (Aplicação Next.js)
APP_DOMAIN=intranet.fazendaprogresso.com.br

# Subdomínio 2: API de Arquivos S3 (Download e Upload de Documentos)
S3_DOMAIN=s3.fazendaprogresso.com.br

# Subdomínio 3: Console Gráfico do MinIO (Painel de Gestão do S3)
MINIO_CONSOLE_DOMAIN=minio.fazendaprogresso.com.br

# Subdomínio 4: Dashboard do Proxy Reverso Traefik (Métricas e Rotas)
TRAEFIK_DOMAIN=traefik.fazendaprogresso.com.br

# E-mail para emissão e renovação automática de certificados SSL (Let's Encrypt / ACME)
ACME_EMAIL=admin@fazendaprogresso.com.br

# Portas padrão de atendimento
HTTP_PORT=80
HTTPS_PORT=443

# Porta opcional de acesso direto ao dashboard do Traefik (além do subdomínio)
TRAEFIK_DASHBOARD_PORT=8080
# Hash htpasswd bcrypt do usuário 'admin' com senha 'Admin@FPOne2026!'
# Para gerar outra senha: `echo $(htpasswd -nbB admin SUA_SENHA) | sed -e s/\\$/\\$\\$/g`
TRAEFIK_BASIC_AUTH=admin:$$2y$$05$$eWpL9B98b8b7hN5pCqU.yO0rWj7Y6A1qZ4V3n7E4mK9R5G0bU3P1y

# ==============================================================================
# 2. Banco de Dados (PostgreSQL 16)
# ==============================================================================
POSTGRES_USER=fpone
POSTGRES_PASSWORD=AltereParaUmaSenhaForte_Postgres2026!
POSTGRES_DB=fpone
DATABASE_URL=postgresql://fpone:AltereParaUmaSenhaForte_Postgres2026!@db:5432/fpone

# ==============================================================================
# 3. Armazenamento de Objetos S3 (MinIO + MinIO Client)
# ==============================================================================
# Imagem do servidor MinIO no Docker Hub
MINIO_IMAGE=elestio/minio:latest
# Imagem do MinIO Client (mc) no Docker Hub
MINIO_MC_IMAGE=chainguard/minio-client:latest

# Usuário local de administração do MinIO (Console Web em https://minio.seu-dominio)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=Admin@FPOne2026!
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
S3_BUCKET=fpone-files

# URL pública que o navegador utiliza para download (usa o subdomínio S3_DOMAIN com https ou http)
S3_PUBLIC_URL=https://s3.fazendaprogresso.com.br

# ==============================================================================
# 4. Usuário Master / Administração Local da Aplicação
# ==============================================================================
MASTER_ADMIN_USERNAME=admin
MASTER_ADMIN_PASSWORD=Admin@FPOne2026!
MASTER_ADMIN_EMAIL=admin@fazendaprogresso.com.br

# ==============================================================================
# 5. Autenticação & Criptografia (Auth.js)
# ==============================================================================
# Gere chaves aleatórias seguras com: `openssl rand -hex 32`
AUTH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# URL canônica da aplicação para onde o login redireciona (usa o subdomínio APP_DOMAIN)
AUTH_URL=https://intranet.fazendaprogresso.com.br
AUTH_SESSION_HOURS=8
# Pepper aleatório para hash HMAC-SHA256 de CPF dos colaboradores
CPF_PEPPER=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TRUST_PROXY=true

# ==============================================================================
# 6. Active Directory / LDAP Corporativo
# ==============================================================================
AD_ENABLED=true
LDAP_HOST='192.168.77.250'
LDAP_PORT=389
LDAP_SECURITY='none'
LDAP_BASE_DN='dc=fazendaprogresso,dc=com,dc=local'
LDAP_BIND_DN='FP\glpi'
LDAP_BIND_PASSWORD=''
LDAP_LOGIN_ATTRIBUTE='sAMAccountName'
LDAP_USER_FILTER='(&(objectClass=user)(objectCategory=person)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))'
LDAP_TIMEOUT_MS=5000
LDAP_CONNECT_TIMEOUT_MS=5000
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_CA_CERT_PATH=''

# Proteção contra força bruta
LOGIN_MAX_FAILS_PER_USER=5
LOGIN_MAX_FAILS_PER_IP=20
LOGIN_RATE_WINDOW_MINUTES=15

# ==============================================================================
# 7. Suporte e Canais de TI
# ==============================================================================
GLPI_TICKET_URL=''
IT_SUPPORT_PHONE=''
IT_SUPPORT_EMAIL='suporte.ti@fazendaprogresso.com.br'

# ==============================================================================
# 8. Identidade e Metadados
# ==============================================================================
NEXT_PUBLIC_COMPANY_NAME="Fazenda Progresso"
NEXT_PUBLIC_APP_ENV=production
AUDIT_RETENTION_MONTHS=24
DEMO_MODE=false
FEATURE_AI_SEARCH=false

# ==============================================================================
# 9. Backup Automatizado
# ==============================================================================
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=14
