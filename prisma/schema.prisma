// Schema da FPOne Intranet.
// Toda mudança entra por migration versionada. Migrations destrutivas só com autorização explícita.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

/// Perfis (§18, §170). PROJECT_MANAGER saiu do MVP com o módulo Projetos (§183).
enum Role {
  ADMIN
  COMMUNICATION_MANAGER
  HR_MANAGER
  MANAGER
  EMPLOYEE
}

/// Registro de RH vindo da carga CSV (§184). O CPF nunca é guardado: só o HMAC.
model Employee {
  id             String         @id @default(uuid()) @db.Uuid
  matricula      String         @unique
  name           String
  unit           String
  department     String
  jobTitle       String         @map("job_title")
  corporateEmail String?        @unique @map("corporate_email")
  /// sAMAccountName do AD em minúsculas: vínculo principal do login de rede.
  adUsername     String?        @unique @map("ad_username")
  /// Telefone corporativo ou autorizado para divulgação (§102).
  corporatePhone String?        @map("corporate_phone")
  /// Aniversário só com dia e mês (LGPD, RN-BDAY-002): o ano nunca é gravado.
  birthDay       Int?           @map("birth_day") @db.SmallInt
  birthMonth     Int?           @map("birth_month") @db.SmallInt
  status         EmployeeStatus @default(ACTIVE)

  /// HMAC-SHA256(cpf_normalizado, CPF_PEPPER), em hex. Nulo para quem foi criado no 1º login do AD.
  cpfHash        String?   @map("cpf_hash")
  /// argon2id. Nulo = precisa fazer o primeiro acesso.
  pinHash        String?   @map("pin_hash")
  pinSetAt       DateTime? @map("pin_set_at") @db.Timestamptz(3)
  /// Incrementado a cada redefinição; invalida tokens de primeiro acesso antigos.
  pinVersion     Int       @default(0) @map("pin_version")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User?
  responsibilities EmployeeResponsibility[]

  @@map("employee")
}

/// Conta de acesso (1:1 com Employee). Autorização por perfis via can() (RN-CORE-001).
model User {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @unique @map("employee_id") @db.Uuid
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  roles          Role[]    @default([EMPLOYEE])
  /// Incrementado ao inativar ou redefinir PIN: encerra sessões antigas (§182, RN-AUTH-004).
  sessionVersion Int       @default(0) @map("session_version")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  authoredPublications Publication[]        @relation("PublicationAuthor")
  editedPublications   Publication[]        @relation("PublicationLastEditor")
  publicationReads     PublicationRead[]
  publicationVersions  PublicationVersion[]
  ownedLinks           UsefulLink[]
  createdEvents        Event[]              @relation("EventCreator")
  updatedEvents        Event[]              @relation("EventUpdater")
  ownedDocuments       Document[]
  uploadedVersions     DocumentVersion[]
  activityDays         UserActivityDay[]

  @@map("user")
}

/// Tentativas de autenticação por IP (RN-AUTH-008: 20 por 15 min). Limpeza periódica.
model AuthAttempt {
  id        BigInt   @id @default(autoincrement())
  ip        String
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ip, createdAt])
  @@map("auth_attempt")
}

/// Trilha de auditoria (RN-AUD-001/002). Somente INSERT: um trigger bloqueia UPDATE/DELETE.
/// metadata nunca contém CPF, PIN ou dados pessoais.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

/// Comunicado (oficial, pode exigir ciência) ou Novidade (leve, nunca exige ciência) (§183).
enum PublicationType {
  ANNOUNCEMENT
  NEWS
}

/// Estados da publicação (RN-COM-001, §171).
enum PublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
  EXPIRED
}

/// Público-alvo (§75). GROUP ainda sem cadastro de grupos.
enum AudienceType {
  ALL
  UNIT
  DEPARTMENT
  GROUP
  USER
}

model PublicationCategory {
  id           String          @id @default(uuid()) @db.Uuid
  type         PublicationType
  name         String
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  publications Publication[]

  @@unique([type, name])
  @@map("publication_category")
}

/// Publicação (§73). Visibilidade calculada na leitura: publish_at <= agora < expires_at (RN-COM-005/006).
model Publication {
  id                      String               @id @default(uuid()) @db.Uuid
  type                    PublicationType
  title                   String
  summary                 String               @default("")
  /// Documento TipTap (JSON) validado no servidor; renderizado sem HTML cru.
  content                 Json
  categoryId              String?              @map("category_id") @db.Uuid
  category                PublicationCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId                String               @map("author_id") @db.Uuid
  author                  User                 @relation("PublicationAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  lastEditorId            String               @map("last_editor_id") @db.Uuid
  lastEditor              User                 @relation("PublicationLastEditor", fields: [lastEditorId], references: [id], onDelete: Restrict)
  status                  PublicationStatus    @default(DRAFT)
  isFeatured              Boolean              @default(false) @map("is_featured")
  pinned                  Boolean              @default(false)
  requiresAcknowledgement Boolean              @default(false) @map("requires_acknowledgement")
  /// Versão lógica; sobe a cada alteração material após publicar (RN-COM-007/008).
  version                 Int                  @default(1)
  publishAt               DateTime?            @map("publish_at") @db.Timestamptz(3)
  expiresAt               DateTime?            @map("expires_at") @db.Timestamptz(3)
  publishedAt             DateTime?            @map("published_at") @db.Timestamptz(3)
  archivedAt              DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  audiences PublicationAudience[]
  reads     PublicationRead[]
  versions  PublicationVersion[]

  @@index([type, status, publishAt])
  @@map("publication")
}

model PublicationAudience {
  id            String       @id @default(uuid()) @db.Uuid
  publicationId String       @map("publication_id") @db.Uuid
  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  audienceType  AudienceType @map("audience_type")
  /// Texto de unidade/departamento (do CSV) ou id do usuário; nulo para ALL.
  audienceId    String?      @map("audience_id")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([audienceType, audienceId])
  @@index([publicationId])
  @@map("publication_audience")
}

/// Leitura e ciência (§74). Um registro por usuário e publicação (CLAUDE.md); a ciência vale
/// só para a versão confirmada (RN-ACK-002/006). Confirmações anteriores ficam na auditoria.
model PublicationRead {
  id                  String      @id @default(uuid()) @db.Uuid
  publicationId       String      @map("publication_id") @db.Uuid
  publication         Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  userId              String      @map("user_id") @db.Uuid
  user                User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  firstViewedAt       DateTime    @default(now()) @map("first_viewed_at") @db.Timestamptz(3)
  lastViewedAt        DateTime    @default(now()) @map("last_viewed_at") @db.Timestamptz(3)
  viewCount           Int         @default(1) @map("view_count")
  acknowledgedAt      DateTime?   @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedVersion Int?        @map("acknowledged_version")

  @@unique([publicationId, userId])
  @@index([userId])
  @@map("publication_read")
}

/// Histórico de versões publicadas (RN-COM-007).
model PublicationVersion {
  id            String      @id @default(uuid()) @db.Uuid
  publicationId String      @map("publication_id") @db.Uuid
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  version       Int
  title         String
  summary       String
  content       Json
  editorId      String      @map("editor_id") @db.Uuid
  editor        User        @relation(fields: [editorId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([publicationId, version])
  @@map("publication_version")
}

/// Responsabilidades cadastradas por perfil autorizado (§97, RN-PROF-006). Nunca inferidas.
model EmployeeResponsibility {
  id             String   @id @default(uuid()) @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  responsibility String
  keywords       String[] @default([])
  /// Responsável principal ou de apoio (RN-DIR-003).
  isPrimary      Boolean  @default(true) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([employeeId])
  @@map("employee_responsibility")
}

/// Links úteis (§162): atalhos cadastrados no FPOne Admin, segmentáveis e ordenáveis.
model UsefulLink {
  id          String               @id @default(uuid()) @db.Uuid
  label       String
  description String               @default("")
  /// Só http(s) ou rota interna iniciada por "/" (RN-LNK-004).
  url         String
  active      Boolean              @default(true)
  sortOrder   Int                  @default(0) @map("sort_order")
  /// Responsável administrativo (RN-LNK-006).
  ownerId     String               @map("owner_id") @db.Uuid
  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  audiences   UsefulLinkAudience[]
  clicks      LinkClick[]

  @@index([active, sortOrder])
  @@map("useful_link")
}

model UsefulLinkAudience {
  id           String       @id @default(uuid()) @db.Uuid
  linkId       String       @map("link_id") @db.Uuid
  link         UsefulLink   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  audienceType AudienceType @map("audience_type")
  audienceId   String?      @map("audience_id")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([audienceType, audienceId])
  @@index([linkId])
  @@map("useful_link_audience")
}

/// Estados do evento (RN-EVT-001, §171). FINISHED é calculado pela data de término na leitura.
enum EventStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  CANCELLED
  FINISHED
}

/// Agenda / Eventos (§160). end_at >= start_at garantido também no banco (RN-EVT-002).
model Event {
  id           String          @id @default(uuid()) @db.Uuid
  title        String
  description  String          @default("")
  location     String          @default("")
  startAt      DateTime        @map("start_at") @db.Timestamptz(3)
  endAt        DateTime        @map("end_at") @db.Timestamptz(3)
  status       EventStatus     @default(DRAFT)
  cancelledAt  DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelReason String?         @map("cancel_reason")
  createdById  String          @map("created_by_id") @db.Uuid
  createdBy    User            @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById  String          @map("updated_by_id") @db.Uuid
  updatedBy    User            @relation("EventUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  audiences    EventAudience[]

  @@index([status, startAt])
  @@map("event")
}

model EventAudience {
  id           String       @id @default(uuid()) @db.Uuid
  eventId      String       @map("event_id") @db.Uuid
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  audienceType AudienceType @map("audience_type")
  audienceId   String?      @map("audience_id")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([audienceType, audienceId])
  @@index([eventId])
  @@map("event_audience")
}

/// Estados do documento e de cada versão (RN-DOC-003).
enum DocumentStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

/// Documentos (§14, §161). Arquivos no MinIO/Garage; aqui só metadados. Publicado nunca é apagado (RN-DOC-010).
model Document {
  id             String             @id @default(uuid()) @db.Uuid
  title          String
  description    String             @default("")
  category       String
  status         DocumentStatus     @default(DRAFT)
  /// Versão vigente (0 = ainda sem arquivo).
  currentVersion Int                @default(0) @map("current_version")
  ownerId        String             @map("owner_id") @db.Uuid
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  /// Vigência e próxima revisão (RN-DOC-006), opcionais.
  effectiveAt    DateTime?          @map("effective_at") @db.Timestamptz(3)
  reviewAt       DateTime?          @map("review_at") @db.Timestamptz(3)
  publishedAt    DateTime?          @map("published_at") @db.Timestamptz(3)
  archivedAt     DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  versions       DocumentVersion[]
  audiences      DocumentAudience[]

  @@index([status, publishedAt])
  @@map("document")
}

/// Cada envio vira uma versão; a anterior passa a SUPERSEDED e nunca é sobrescrita (RN-DOC-001/002/004).
model DocumentVersion {
  id           String         @id @default(uuid()) @db.Uuid
  documentId   String         @map("document_id") @db.Uuid
  document     Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      Int
  fileName     String         @map("file_name")
  storageKey   String         @unique @map("storage_key")
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  sha256       String
  status       DocumentStatus @default(DRAFT)
  uploadedById String         @map("uploaded_by_id") @db.Uuid
  uploadedBy   User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt  DateTime?      @map("published_at") @db.Timestamptz(3)

  @@unique([documentId, version])
  @@map("document_version")
}

model DocumentAudience {
  id           String       @id @default(uuid()) @db.Uuid
  documentId   String       @map("document_id") @db.Uuid
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  audienceType AudienceType @map("audience_type")
  audienceId   String?      @map("audience_id")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([audienceType, audienceId])
  @@index([documentId])
  @@map("document_audience")
}

/// Atividade diária (RN-KPI-001, decisão da Fase 7): só usuário e dia, sem páginas nem horários.
/// Base de DAU/WAU/MAU e taxa de retorno. Uma linha por usuário por dia.
model UserActivityDay {
  userId String   @map("user_id") @db.Uuid
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Dia no fuso corporativo (America/Bahia).
  day    DateTime @db.Date

  @@id([userId, day])
  @@index([day])
  @@map("user_activity_day")
}

/// Busca realizada (§43), sem o texto pesquisado nem o usuário (pode conter nomes).
model SearchEvent {
  id          BigInt   @id @default(autoincrement())
  resultCount Int      @map("result_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("search_event")
}

/// Clique em link útil (§43), sem o usuário.
model LinkClick {
  id        BigInt     @id @default(autoincrement())
  linkId    String     @map("link_id") @db.Uuid
  link      UsefulLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([linkId])
  @@map("link_click")
}
